# Set environment variables in PowerShell; the app does not automatically load this file.
PORT=3001
DB_PATH=./data/workspace.db
HOST=127.0.0.1
# Production requires HTTPS and secure cookies.
NODE_ENV=development
# Required for first-time setup when NODE_ENV=production; use a unique secret.
# SETUP_TOKEN=replace-with-an-operator-generated-secret
# Optional for npm run seed; otherwise a random password is printed once.
# DEMO_PASSWORD=choose-a-long-unique-password
# Leave DB_PATH unset when using seed + dev:demo to select the separate demo file.
