{
  "name": "finbiz-360",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "dev:demo": "concurrently -k -n api,web \"node --watch server/index.js --demo\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "test": "node --test tests/*.test.js",
    "backup": "node server/backup.js",
    "format": "prettier --write src server scripts tests docs vite.config.ts tsconfig.json package.json README.md",
    "format:check": "prettier --check src server scripts tests docs vite.config.ts tsconfig.json package.json README.md",
    "restore": "node server/restore.js",
    "restore:encrypted": "node scripts/restore-encrypted.mjs",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "csv-parse": "^6.1.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.4.1"
  }
}
